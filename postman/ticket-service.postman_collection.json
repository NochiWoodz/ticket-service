    {
      "name": "1. Generar tickets (EFS + subida automatica)",
      "item": [
        {
          "name": "Generar ticket VIP (auto S3)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/tickets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets"
              ]
            },
            "description": "Genera el PDF en EFS y lo sube automaticamente a S3.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoCodigo\": \"evento123\",\n  \"usuarioId\": \"usuarioX\",\n  \"nombreAsistente\": \"Juan Pérez\",\n  \"emailAsistente\": \"juan.perez@mail.cl\",\n  \"categoria\": \"VIP\",\n  \"asiento\": \"A-12\",\n  \"estado\": \"VENDIDO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"ticketId\", j.id);",
                  "pm.test(\"Guardado en EFS\", () => pm.expect(j.enEfs).to.be.true);",
                  "pm.test(\"Subido a S3 con estructura evento/usuario/ticket.pdf\", () => pm.expect(j.s3Key).to.match(/^evento123\\/usuarioX\\/ticket\\d+\\.pdf$/));"
                ]
              }
            }
          ]
        },
